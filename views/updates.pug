doctype html
html 
  head 
    title= 'Update Custom Object Form | Integrating With HubSpot I Practicum'
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body    
    h1 Enter New Company Data
    .form-wrapper
      form(method="POST")
        label(for="newName") New company name
        input(type="text" value="newName" required)
        label(for="newCity") New company city
        input(type="text" value="newCity" required)
        label(for="newDomainName") New company domain name
        input(type="text" value="newDomainName" required)
        label(for="newAge") New company age
        input(type="text" value="newAge" required)
        label(for="newColor") New company color
        input(type="text" value="newColor" required)
        label(for="newStatus") New company name
        select#newStatus(name='statuses' required)
          option(value='alive') Alive
          option(value='deceased') Deceased
        input(type="submit" value="Submit")
    a(href='/') Return to the homepage

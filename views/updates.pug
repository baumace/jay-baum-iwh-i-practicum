doctype html
html 
  head 
    title= `${title}`
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body    
    h1 Enter New Company Data
    a(href='/') Return to the homepage
    .form-wrapper
      form(method="POST")
        label(for="name") Name
        input(type="text" name="name" required)
        label(for="city") City
        input(type="text" name="city" required)
        label(for="domainName") Domain Name
        input(type="text" name="domainName" required)
        label(for="age") Age
        input(type="text" name="age" required)
        label(for="color") Color
        input(type="text" name="color" required)
        label(for="activityStatus") Activity Status
        select#activityStatus(name='activityStatus' required)
          option(value='Alive') Alive
          option(value='Deceased') Deceased
        input(type="submit" value="Submit")
